const { name, size = 16, class: className } = Astro.props;
const paths: Record<string, string> = {
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6.5 8.1 5.4a1.6 1.6 0 0 0 1.8 0L21 6.5"/>',
  linkedin:
    '<path d="M4.5 9.5v9"/><circle cx="4.5" cy="4.9" r="1.6"/><path d="M9.5 18.5v-9"/><path d="M9.5 13.2c0-2.1 1.5-3.7 3.6-3.7s3.9 1.6 3.9 3.7v5.3"/>',
  github:
    '<path d="M9 19.5c-4.3 1.3-4.3-2.2-6-2.7m12 5.2v-3.6c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6.1 0-1.3-.5-2.4-1.3-3.3.1-.4.6-1.6-.1-3.2 0 0-1-.3-3.4 1.3a11.6 11.6 0 0 0-6.2 0C6.6 2.5 5.6 2.8 5.6 2.8c-.7 1.6-.2 2.8-.1 3.2A4.8 4.8 0 0 0 4 9.3c0 4.6 2.7 5.8 5.5 6.1-.6.6-.6 1.2-.5 2v3.6"/>',
  file: '<path d="M14 2.5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7.5z"/><path d="M14 2.5v5h5"/><path d="M9 13h6M9 17h4"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.2" fill="currentColor" stroke="none"/>',
  arrow: '<path d="M4 12h16M13 5l7 7-7 7"/>',
  external: '<path d="M14 4h6v6"/><path d="m20 4-9 9"/><path d="M18 14v5a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V7.5A1.5 1.5 0 0 1 5 6h5"/>',
  code: '<path d="m8.5 8-4 4 4 4"/><path d="m15.5 8 4 4-4 4"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/>',
  tag: '<path d="M3.5 12.2V5a1.5 1.5 0 0 1 1.5-1.5h7.2a2 2 0 0 1 1.4.6l6.8 6.8a2 2 0 0 1 0 2.8l-6.6 6.6a2 2 0 0 1-2.8 0l-6.9-6.9a2 2 0 0 1-.6-1.4Z"/><circle cx="8.2" cy="8.2" r="1.2" fill="currentColor" stroke="none"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
