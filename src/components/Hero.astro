---
import { site } from '@/data/site';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';
import fs from 'node:fs';
import path from 'node:path';

const photo = (site as { photo?: string }).photo;
const firstName = site.name.split(' ')[0];
const surname = site.name.slice(firstName.length).trim();
const focus = (site as { focus?: string[] }).focus ?? [];

// Local files (résumé PDF, photo) are only linked when they actually exist,
// so the build never ships a dead link.
const fileExists = (name: string) => fs.existsSync(path.join(process.cwd(), 'public', name));
const links = site.links.filter(
  (link) => /^(https?:|mailto:)/.test(link.href) || fileExists(link.href)
);
const hasPhoto = Boolean(photo) && fileExists(photo as string);
---

<section class="wrap hero-section" id="about">
  <div class="hero">
    <div class="hero-main">
      <p class="eyebrow hero-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        {site.role}
      </p>

      <h1 class="hero-title">
        {firstName}{' '}<span class="hero-surname">{surname}</span>
      </h1>

      <p class="hero-tagline">{site.tagline}</p>

      <p class="hero-meta">
        {site.location}{site.currently && ` · `}
        {site.currently && <span class="hero-currently">{site.currently}</span>}
      </p>

      <div class="hero-actions">
        {
          links.map((link) => (
            <a
              class:list={[
                'btn',
                { 'btn--solid': link.icon === 'mail', 'btn--resume': link.icon === 'file' },
              ]}
              href={/^(https?:|mailto:)/.test(link.href) ? link.href : url(link.href)}
              target={link.icon === 'mail' ? undefined : '_blank'}
              rel={link.icon === 'mail' ? undefined : 'noopener'}
            >
              <Icon name={link.icon as any} size={15} />
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-aside">
      <div class="portrait" aria-hidden={hasPhoto ? undefined : 'true'}>
        {hasPhoto ? (
          <img src={url(photo as string)} alt={`Portrait of ${site.name}`} width="480" height="480" />
        ) : (
          <span class="portrait-initials">{site.initials}</span>
        )}
        <span class="portrait-grid" aria-hidden="true"></span>
      </div>

      {focus.length > 0 && (
        <div class="hero-card">
          <p class="hero-card-label">Focus</p>
          <ul class="hero-focus">
            {focus.map((item) => <li>{item}</li>)}
          </ul>
          <p class="hero-card-hint">
            <a href={url('blog/')}>Read the writing →</a>
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(3rem, 9vw, 6rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.75rem;
    align-items: start;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.1rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero-title {
    font-size: clamp(2.9rem, 7.5vw, 4.9rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 1.4rem;
  }

  .hero-surname {
    display: block;
    font-style: italic;
    font-weight: 300;
    color: var(--ink-soft);
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .hero-meta {
    margin-top: 1.15rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .hero-currently {
    color: var(--accent-ink);
    min-width: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  :global(.btn--resume) {
    border-style: dashed;
  }

  @media (max-width: 520px) {
    :global(.hero-actions .btn--resume) {
      flex-basis: 100%;
      justify-content: center;
    }
  }

  .hero-aside {
    display: grid;
    gap: 1rem;
    max-width: 20rem;
  }

  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-subtle);
    border: 1px solid var(--rule);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(12%);
  }

  .portrait-initials {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 9vw, 5rem);
    letter-spacing: -0.03em;
    color: var(--accent-ink);
    opacity: 0.75;
  }

  .portrait-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity: 0.4;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  :root[data-theme='dark'] .portrait-grid {
    mix-blend-mode: screen;
    opacity: 0.18;
  }

  .hero-card {
    border-left: 2px solid var(--accent);
    padding: 0.15rem 0 0.15rem 0.9rem;
  }

  .hero-card-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .hero-focus {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  .hero-focus li {
    padding-left: 0.9rem;
    position: relative;
  }

  .hero-focus li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 4px;
    height: 1px;
    background: var(--faint);
  }

  .hero-card-hint {
    font-size: 0.82rem;
    margin-top: 0.8rem;
  }

  .hero-card-hint a {
    color: var(--accent-ink);
    text-decoration: none;
  }

  .hero-card-hint a:hover {
    text-decoration: underline;
  }

  @media (max-width: 819px) {
    .hero-aside {
      display: none;
    }
    .hero-section {
      padding-top: 2.25rem;
    }
    .hero-title {
      font-size: clamp(2.6rem, 13vw, 3.4rem);
    }
  }

  @media (min-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17.5rem;
      gap: 4rem;
      align-items: end;
    }
    .hero-aside {
      padding-bottom: 0.4rem;
    }
  }

  @media print {
    .hero-aside,
    .hero-actions {
      display: none;
    }
    .hero-section {
      padding-top: 0;
    }
  }
</style>
