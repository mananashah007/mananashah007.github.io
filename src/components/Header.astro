---
import { site } from '@/data/site';
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';

const photo = (site as { photo?: string }).photo;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href={url('')} aria-label={`${site.name} — home`}>
      <span class="wordmark-mark">{site.initials}</span>
      <span class="wordmark-text">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          [
            { label: 'About', path: '', hash: '#about' },
            { label: 'Experience', path: '', hash: '#experience' },
            { label: 'Skills', path: '', hash: '#skills' },
            { label: 'Writing', path: 'blog/' },
          ].map((item) => (
            <li>
              <a
                href={url(item.path) + (item.hash ?? '')}
                aria-current={item.path === '' && current === '/' && item.hash === '#about' ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="icon-btn" id="theme-toggle" aria-pressed="false" aria-label="Switch to dark theme">
        <span class="icon-sun"><Icon name="sun" size={17} /></span>
        <span class="icon-moon"><Icon name="moon" size={17} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 3.75rem;
    padding-block: 0.65rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-right: auto;
    white-space: nowrap;
  }

  .wordmark-mark {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background-color 0.2s var(--ease);
  }

  .wordmark:hover .wordmark-mark {
    background: var(--accent-ink);
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    font-size: 0.855rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s var(--ease), border-color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }

  .icon-btn:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
    background: var(--bg-subtle);
  }

  .icon-btn span {
    display: grid;
    place-items: center;
  }

  [data-theme='light'] .icon-moon,
  [data-theme='dark'] .icon-sun {
    display: none;
  }

  @media (max-width: 640px) {
    .wordmark-text {
      display: none;
    }
    .site-nav ul {
      gap: 1.1rem;
    }
    .site-nav a {
      font-size: 0.82rem;
    }
  }

  @media print {
    .site-header {
      position: static;
      border-bottom: 1px solid #ccc;
    }
    .site-nav,
    .header-actions {
      display: none;
    }
  }
</style>
