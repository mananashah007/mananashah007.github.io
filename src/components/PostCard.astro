---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';
import { url } from '@/lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
  /** 'list' for the index, 'featured' for the home page. */
  variant?: 'list' | 'featured';
  /** Relative URL of the post, computed by the parent page. */
  href: string;
}

const { post, variant = 'list', href } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const iso = pubDate.toISOString();
---

<a class:list={['post-card', `post-card--${variant}`]} href={url(href)}>
  <div class="post-card-meta">
    <time datetime={iso}>{fmt(pubDate)}</time>
    {tags.length > 0 && (
      <span class="post-card-tags">
        {tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
      </span>
    )}
  </div>

  <h3 class="post-card-title">{title}</h3>
  <p class="post-card-desc">{description}</p>

  <span class="post-card-cta">
    Read <Icon name="arrow" size={14} />
  </span>
</a>

<style>
  .post-card {
    display: grid;
    gap: 0.55rem;
    padding: 1.35rem 1.5rem 1.3rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg-elevated);
    text-decoration: none;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  .post-card:hover {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -18px rgb(0 0 0 / 0.4);
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--faint);
  }

  .post-card-meta time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }

  .post-card-tags {
    display: flex;
    gap: 0.35rem;
  }

  .tag {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
  }

  .post-card-title {
    font-size: 1.22rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .post-card:hover .post-card-title {
    color: var(--accent-ink);
  }

  .post-card-desc {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .post-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }

  .post-card-cta svg {
    transition: transform 0.18s var(--ease);
  }

  .post-card:hover .post-card-cta {
    color: var(--accent-ink);
  }

  .post-card:hover .post-card-cta svg {
    transform: translateX(3px);
  }

  .post-card--featured {
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 0;
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
  }

  .post-card--featured:hover {
    box-shadow: none;
    transform: none;
  }

  .post-card--featured .post-card-title {
    font-size: 1.3rem;
  }
</style>
