---
import { education } from '@/data/site';
---

<ol class="edu">
  {education.map((item) => (
    <li class="edu-item">
      <div class="edu-when">
        <span class="edu-year">{item.year}</span>
        {item.location && <span class="edu-where">{item.location}</span>}
      </div>
      <div class="edu-what">
        <h3 class="edu-degree">{item.degree}</h3>
        <p class="edu-school">{item.school}</p>
        {item.detail && <p class="edu-detail">{item.detail}</p>}
        {item.courses && item.courses.length > 0 && (
          <p class="edu-courses">
            <span class="edu-courses-label">Key coursework</span>
            {item.courses.join(' · ')}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .edu-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .edu-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .edu-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.75rem;
    padding-top: 0.3rem;
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .edu-where {
    font-size: 0.8rem;
    color: var(--faint);
  }

  .edu-degree {
    font-size: var(--step-1);
  }

  .edu-school {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent-ink);
    margin-top: 0.15rem;
  }

  .edu-detail {
    font-size: 0.92rem;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }

  .edu-courses {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.65rem;
  }

  .edu-courses-label {
    display: inline-block;
    margin-right: 0.5rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (min-width: 720px) {
    .edu-item {
      grid-template-columns: 10.5rem minmax(0, 1fr);
      gap: 0 2.5rem;
    }
    .edu-when {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
