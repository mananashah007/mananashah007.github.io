---
import { awards, certifications } from '@/data/site';

const certs = certifications;
const honours = awards;
---

<div class="creds">
  {
    certs.length > 0 && (
      <section class="cred-block" aria-labelledby="certs-title">
        <h3 class="cred-title" id="certs-title">Certifications</h3>
        <ul class="cert-list">
          {certs.map((cert) => (
            <li>
              <span class="cert-name">{cert.name}</span>
              {cert.issuer && <span class="cert-meta">{cert.issuer}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    honours.length > 0 && (
      <section class="cred-block" aria-labelledby="awards-title">
        <h3 class="cred-title" id="awards-title">Awards</h3>
        <ul class="award-list">
          {honours.map((award) => (
            <li class="award">
              <p class="award-title">{award.title}</p>
              <p class="award-org">{award.org}</p>
              {award.note && <p class="award-note">{award.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .creds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.5rem;
  }

  .cred-title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1rem;
  }

  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .cert-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
    align-items: baseline;
  }

  .cert-name {
    color: var(--ink-soft);
  }

  .cert-meta {
    font-size: 0.76rem;
    color: var(--faint);
  }

  .award-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .award-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .award-org {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent-ink);
    margin-top: 0.1rem;
  }

  .award-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }
</style>
